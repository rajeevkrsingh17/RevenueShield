# RevenueShield Environment Variables Configuration
# Required for deployment — set these in your hosting platform (Vercel, etc.)

# PostgreSQL Database URL (Neon, Supabase, or any PostgreSQL provider)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secret for authentication (generate a random 64-char string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Optional: Anthropic API Key for AI Copilot
ANTHROPIC_API_KEY=""
