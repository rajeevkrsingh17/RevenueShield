# RevenueShield Environment Variables Configuration Example
# If credentials are absent, the application defaults gracefully to DEMO MODE

# Optional Razorpay Test Mode Credentials
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional OpenAI / LLM API Key for real-time model integration
VITE_OPENAI_API_KEY=
